# Copy this file to .env and fill in your values

# Which model to use: gemini (free API) or ollama (local, fully private)
LLM_PROVIDER=gemini

# Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here
# Model tested on the free tier (Nov 2026). If Google retires it, list models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama — only needed if LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Groq — free backup model, used automatically if Gemini fails or hits its limit
# Free key from https://console.groq.com/keys  (leave empty to disable the backup)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
